        "url": "={{$env.SUPABASE_URL}}/rest/v1/campaigns?id=eq.{{$('Prepare Query').first().json.campaign.id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "apikey", "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"},
            {"name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"},
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"status\":\"sent\",\"launched_at\":\"{{$now}}\"}"
      },
      "id": "mark-campaign",
